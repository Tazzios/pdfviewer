<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="content" method="upgrade">
	<name>plg_content_pdfviewer</name>
	<author>Tazzios</author>
	<creationDate>November 2026</creationDate>
	<copyright></copyright>
	<license>GNU/GPLv3 www.gnu.org/licenses/gpl-3.0.html</license>
	<authorEmail></authorEmail>
	<authorUrl>https://github.com/Tazzios</authorUrl>
	<version>1.6.2</version>
	<description>PLG_CONTENT_PDFVIEWER_XML_DESCRIPTION</description>
	<namespace path="src">Tazzios\Plugin\Content\Pdfviewer</namespace>
	<files>
		<folder plugin="pdfviewer">services</folder>
		<folder>src</folder>
		<folder>language</folder>
		<folder>assets</folder>
	</files>
	<!-- Also installed in administrator/language, so an update replaces older copies there -->
	<languages folder="language">
		<language tag="en-GB">en-GB/plg_content_pdfviewer.ini</language>
		<language tag="en-GB">en-GB/plg_content_pdfviewer.sys.ini</language>
	</languages>
	<config>
		<fields name="params">
			<fieldset name="basic">
				<field name="viewer" type="list" default="pdfjs" label="PLG_CONTENT_PDFVIEWER_FIELD_VIEWER_LABEL">
					<option value="pdfjs">pdfjs</option>
					<option value="pdfimage">pdfimage</option>
				</field>
				<field name="style" type="list" default="Embed" label="PLG_CONTENT_PDFVIEWER_FIELD_STYLE_LABEL">
					<option value="Embed">PLG_CONTENT_PDFVIEWER_OPTION_EMBED</option>
					<option value="Popup">PLG_CONTENT_PDFVIEWER_OPTION_POPUP</option>
					<option value="New">PLG_CONTENT_PDFVIEWER_OPTION_NEW</option>
				</field>
				<field name="linktext" type="text" default="Download" label="PLG_CONTENT_PDFVIEWER_FIELD_LINKTEXT_LABEL" />
				<field type="spacer" name="myspacer1" label="PLG_CONTENT_PDFVIEWER_SPACER_EMBED" />
				<field name="embedwidth" type="text" default="100%" label="PLG_CONTENT_PDFVIEWER_FIELD_EMBEDWIDTH_LABEL" />
				<field name="embedheight" type="text" default="800" label="PLG_CONTENT_PDFVIEWER_FIELD_EMBEDHEIGHT_LABEL" />
				<field type="spacer" name="myspacer" label="PLG_CONTENT_PDFVIEWER_SPACER_POPUP" />
				<field name="popupwidth" type="text" default="800" label="PLG_CONTENT_PDFVIEWER_FIELD_POPUPWIDTH_LABEL" />
				<field name="popupheight" type="text" default="800" label="PLG_CONTENT_PDFVIEWER_FIELD_POPUPHEIGHT_LABEL" />
				<field name="debug" type="radio" default="0" label="PLG_CONTENT_PDFVIEWER_FIELD_DEBUG_LABEL" layout="joomla.form.field.radio.switcher">
					<option value="0">JOFF</option>
					<option value="1">JON</option>
				</field>
			</fieldset>
		</fields>
	</config>
</extension>
