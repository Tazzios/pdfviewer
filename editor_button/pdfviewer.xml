<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="editors-xtd" method="upgrade">
	<name>plg_editors-xtd_pdfviewer</name>
	<creationDate>November 2026</creationDate>
	<author>Tazzios</author>
	<authorEmail></authorEmail>
	<authorUrl>https://github.com/Tazzios</authorUrl>
	<copyright></copyright>
	<license>GNU/GPLv3 www.gnu.org/licenses/gpl-3.0.html</license>
	<version>1.6.2</version>
	<description>PLG_EDITORSXTD_PDFVIEWER_XML_DESCRIPTION</description>
	<namespace path="src">Tazzios\Plugin\EditorsXtd\Pdfviewer</namespace>
	<files>
		<folder plugin="pdfviewer">services</folder>
		<folder>src</folder>
		<folder>tmpl</folder>
		<folder>language</folder>
	</files>
	<!-- Also installed in administrator/language, so an update replaces older copies there -->
	<languages folder="language">
		<language tag="en-GB">en-GB/plg_editors-xtd_pdfviewer.ini</language>
		<language tag="en-GB">en-GB/plg_editors-xtd_pdfviewer.sys.ini</language>
	</languages>
	<media destination="plg_editors-xtd_pdfviewer" folder="media">
		<folder>css</folder>
		<folder>js</folder>
	</media>
	<config>
		<fields name="params">
			<fieldset name="basic">
				<field name="viewer" type="list" default="pdfjs" label="PLG_EDITORSXTD_PDFVIEWER_FIELD_VIEWER_LABEL"
					description="PLG_EDITORSXTD_PDFVIEWER_FIELD_VIEWER_DESC">
					<option value="pdfjs">pdfjs</option>
					<option value="pdfimage">pdfimage</option>
				</field>
				<field name="style" type="list" default="embed" label="PLG_EDITORSXTD_PDFVIEWER_FIELD_STYLE_LABEL"
					description="PLG_EDITORSXTD_PDFVIEWER_FIELD_STYLE_DESC">
					<option value="embed">PLG_EDITORSXTD_PDFVIEWER_OPTION_EMBED</option>
					<option value="popup">PLG_EDITORSXTD_PDFVIEWER_OPTION_POPUP</option>
					<option value="new">PLG_EDITORSXTD_PDFVIEWER_OPTION_NEW</option>
				</field>
				<field type="spacer" name="spacer_embed" label="PLG_EDITORSXTD_PDFVIEWER_SPACER_EMBED" />
				<field name="embedwidth" type="text" default="100%" label="PLG_EDITORSXTD_PDFVIEWER_FIELD_EMBEDWIDTH_LABEL" description="PLG_EDITORSXTD_PDFVIEWER_FIELD_SIZE_PIXELS_OR_PERCENT_DESC" />
				<field name="embedheight" type="text" default="800" label="PLG_EDITORSXTD_PDFVIEWER_FIELD_EMBEDHEIGHT_LABEL" description="PLG_EDITORSXTD_PDFVIEWER_FIELD_SIZE_PIXELS_DESC" />
				<field type="spacer" name="spacer_popup" label="PLG_EDITORSXTD_PDFVIEWER_SPACER_POPUP" />
				<field name="popupwidth" type="text" default="800" label="PLG_EDITORSXTD_PDFVIEWER_FIELD_POPUPWIDTH_LABEL" description="PLG_EDITORSXTD_PDFVIEWER_FIELD_SIZE_PIXELS_OR_PERCENT_DESC" />
				<field name="popupheight" type="text" default="800" label="PLG_EDITORSXTD_PDFVIEWER_FIELD_POPUPHEIGHT_LABEL" description="PLG_EDITORSXTD_PDFVIEWER_FIELD_SIZE_PIXELS_DESC" />
			</fieldset>
		</fields>
	</config>
</extension>
