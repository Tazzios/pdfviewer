<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="editors-xtd" method="upgrade">
	<name>plg_editors-xtd_pdfviewer</name>
	<creationDate>November 2026</creationDate>
	<author>Tazzios</author>
	<authorEmail></authorEmail>
	<authorUrl>https://github.com/Tazzios</authorUrl>
	<copyright></copyright>
	<license>GNU/GPLv3 www.gnu.org/licenses/gpl-3.0.html</license>
	<version>1.6.2</version>
	<description>PLG_EDITORSXTD_PDFVIEWER_XML_DESCRIPTION</description>
	<namespace path="src">Tazzios\Plugin\EditorsXtd\Pdfviewer</namespace>
	<files>
		<folder plugin="pdfviewer">services</folder>
		<folder>src</folder>
		<folder>tmpl</folder>
		<folder>language</folder>
	</files>
	<media destination="plg_editors-xtd_pdfviewer" folder="media">
		<folder>js</folder>
	</media>
	<config>
		<fields name="params">
			<fieldset name="basic">
				<field name="viewer" type="list" default="pdfjs" label="Default viewer"
					description="Viewer that is selected when the dialog opens. A PDF link always uses pdfjs.">
					<option value="pdfjs">pdfjs</option>
					<option value="pdfimage">pdfimage</option>
				</field>
				<field name="style" type="list" default="embed" label="Default viewer style"
					description="Display style that is selected when the dialog opens.">
					<option value="embed">Embedded</option>
					<option value="popup">Modal Popup</option>
					<option value="new">Open in new window</option>
				</field>
				<field type="spacer" name="spacer_embed" label="Size for embed" />
				<field name="embedwidth" type="text" default="100%" label="Embed width" description="Number of pixels or a percentage, e.g. 100%" />
				<field name="embedheight" type="text" default="800" label="Embed height" description="Number of pixels" />
				<field type="spacer" name="spacer_popup" label="Size for popup" />
				<field name="popupwidth" type="text" default="800" label="Popup width" description="Number of pixels or a percentage" />
				<field name="popupheight" type="text" default="800" label="Popup height" description="Number of pixels" />
			</fieldset>
		</fields>
	</config>
</extension>
